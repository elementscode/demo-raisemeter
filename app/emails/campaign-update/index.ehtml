import "./style.css";
import { raw } from "@elements/app";

export interface UpdateDetails {
  campaignTitle: string;
  campaignSlug: string;
  organizerName: string;
  title: string;
  bodyHtml: string;
}

/**
 * An organizer's update, sent to everyone who has given to the campaign.
 *
 * @email
 */
<html (update: UpdateDetails)>
  <body class="email campaign-update">
    <div class="email-wrap">
      <p class="eyebrow">Update · {update.campaignTitle}</p>
      <h1>{update.title}</h1>

      <div>{raw(update.bodyHtml)}</div>

      <p>{update.organizerName}</p>

      <p><a class="cta" href={`/c/${update.campaignSlug}`}>See the campaign</a></p>

      <div class="email-footer">
        <p>You are getting this because you gave to {update.campaignTitle} on raisemeter.</p>
      </div>
    </div>
  </body>
</html>
