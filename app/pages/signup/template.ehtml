import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";

interface SignupForm {
  name: string;
  email: string;
  password: string;
  error: string;
}

function onSubmit(form: SignupForm, next: string) {
  try {
    signup(form.name, form.email, form.password);
    form.error = "";
    redirect(next);
  } catch (err: any) {
    form.error = err.message;
  }
}

<html lang="en" class="page-signup" (
  next: string,
  private form: SignupForm = { name: "", email: "", password: "", error: "" },
)>
  <head>
    <title>Create an account · raisemeter</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="page-shell">
        <div class="auth">
          <form class="stack is-lg" onsubmit={() => onSubmit(form, next)}>
            <div class="stack is-xs">
              <h1>Start raising</h1>
              <p class="hint">Create an organizer account, then set up your campaign.</p>
            </div>

            <p e:if={form.error} class="error" role="alert">{form.error}</p>

            <div class="field">
              <label for="name">Your name</label>
              <input id="name" name="name" value={form.name} autocomplete="name" placeholder="Shown on your campaigns" required>
            </div>

            <div class="field">
              <label for="email">Email</label>
              <input id="email"
                     name="email"
                     type="email"
                     value={form.email}
                     autocomplete="email"
                     autocapitalize="none"
                     spellcheck={false}
                     placeholder="you@example.com"
                     required>
            </div>

            <div class="field">
              <label for="password">Password</label>
              <input id="password"
                     name="password"
                     type="password"
                     value={form.password}
                     autocomplete="new-password"
                     minlength={MIN_PASSWORD}
                     required>
              <p class="hint">At least {MIN_PASSWORD} characters.</p>
            </div>

            <button type="submit" class="is-primary is-block">Create account</button>

            <p class="text-sm">Already have an account? <a class="link-action" href={`/signin?next=${encodeURIComponent(next)}`}>Sign in</a></p>
          </form>
        </div>
      </div>
    </Layout>
  </body>
</html>
