import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { redirect } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { signup, MIN_PASSWORD } from "#app/shared/services/auth";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Field, FieldGroup } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

interface SignupForm {
  name: string;
  email: string;
  password: string;
  error: string;
}

function onSubmit(form: SignupForm, next: string) {
  try {
    signup(form.name, form.email, form.password);
    form.error = "";
    redirect(next);
  } catch (err: any) {
    form.error = err.message;
  }
}

<html lang="en" class="page-signup" (
  next: string,
  private form: SignupForm = { name: "", email: "", password: "", error: "" },
)>
  <head>
    <title>Create an account · raisemeter</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="page-shell">
        <div class="auth">
          <form class="stack is-lg" onsubmit={() => onSubmit(form, next)}>
            <div class="stack is-xs">
              <h1>Start raising</h1>
              <p class="hint">Create an organizer account, then set up your campaign.</p>
            </div>

            <Alert e:if={form.error} variant="danger" description={form.error} />

            <FieldGroup>
              <Field label="Your name">
                <Input name="name" value={form.name} placeholder="Shown on your campaigns" required attrs={{ autocomplete: "name" }} />
              </Field>

              <Field label="Email">
                <Input name="email"
                       type="email"
                       value={form.email}
                       placeholder="you@example.com"
                       required
                       attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
              </Field>

              <Field label="Password" description={`At least ${MIN_PASSWORD} characters.`}>
                <Input name="password"
                       type="password"
                       value={form.password}
                       required
                       attrs={{ autocomplete: "new-password", minlength: MIN_PASSWORD }} />
              </Field>
            </FieldGroup>

            <Button type="submit" variant="primary" block>Create account</Button>

            <p class="text-sm">Already have an account? <a class="link-action" href={`/signin?next=${encodeURIComponent(next)}`}>Sign in</a></p>
          </form>
        </div>
      </div>
    </Layout>
  </body>
</html>
