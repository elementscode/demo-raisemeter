import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { File, raw, redirect, ValidationError } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { createCampaign } from "#app/shared/services/organizer";
import { renderMarkdown } from "#app/shared/markdown";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Field, FieldGroup } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { InputGroup, InputGroupAddon, InputGroupText } from "@elements/ui/input-group";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@elements/ui/tabs";
import { Textarea } from "@elements/ui/textarea";

const STARTER = `Tell people who you are and what you're raising money for.

## What the money buys

- The first thing
- The second thing

## Who it helps

Say who benefits, and what changes when you hit the goal.`;

interface NewCampaign {
  title: string;
  summary: string;
  story: string;
  goal: string;
  cover: File;
  tab: string;
  errors: { title?: string[]; summary?: string[]; story?: string[]; goal?: string[]; cover?: string[] };
  error: string;
  busy: boolean;
}

const previews = new WeakMap<File, string>();

function coverPreview(cover: File | undefined): string {
  if (!cover?.data?.length || typeof URL === "undefined" || !URL.createObjectURL) {
    return "";
  }

  let url = previews.get(cover);
  if (!url) {
    url = URL.createObjectURL(new Blob([cover.data as BlobPart], { type: cover.contentType }));
    previews.set(cover, url);
  }

  return url;
}

function onSubmit(form: NewCampaign) {
  form.errors = {};
  form.error = "";
  form.busy = true;

  try {
    let slug = createCampaign({
      title: form.title,
      summary: form.summary,
      story: form.story,
      goal: Number(form.goal),
      cover: form.cover,
    });

    redirect(`/c/${slug}`);
  } catch (err: any) {
    form.busy = false;

    if (err instanceof ValidationError && err.errors) {
      form.errors = err.errors;
      form.error = "Fix the fields marked below.";
    } else {
      form.error = err.message;
    }
  }
}

<html lang="en" class="page-campaign-new" (
  private form: NewCampaign = {
    title: "",
    summary: "",
    story: STARTER,
    goal: "5000",
    cover: undefined as any,
    tab: "write",
    errors: {},
    error: "",
    busy: false,
  },
)>
  <head>
    <title>Start a campaign · raisemeter</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="page-shell is-form new">
        <form class="stack is-lg" onsubmit={() => onSubmit(form)}>
          <div class="stack is-xs">
            <p class="eyebrow"><a class="link-muted" href="/dashboard">Your campaigns</a></p>
            <h1>Start a campaign</h1>
            <p class="hint">You can post updates to your donors once it's live.</p>
          </div>

          <Alert e:if={form.error} variant="danger" description={form.error} />

          <FieldGroup>
            <Field label="Title" error={form.errors.title?.[0] ?? ""}>
              <Input name="title" placeholder="A new roof for the community center" value={form.title} required attrs={{ maxlength: 100 }} />
            </Field>

            <Field label="Summary" error={form.errors.summary?.[0] ?? ""}>
              <Input name="summary" placeholder="One line that shows on the campaign card" value={form.summary} required attrs={{ maxlength: 200 }} />
            </Field>

            <Field label="Goal" error={form.errors.goal?.[0] ?? ""}>
              <InputGroup class="goal-input">
                <InputGroupAddon><InputGroupText>$</InputGroupText></InputGroupAddon>
                <Input type="number" name="goal" value={form.goal} required attrs={{ min: 100, step: 1, inputmode: "numeric" }} />
              </InputGroup>
            </Field>

            <Field label="Cover photo" description="A wide photo works best. JPEG, PNG or WebP, up to 5 MB." error={form.errors.cover?.[0] ?? ""}>
              <img e:if={coverPreview(form.cover)} class="cover-preview" src={coverPreview(form.cover)} alt="Cover preview">
              <input id="cover" name="cover" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class={[form.errors.cover && "is-error"]} value={form.cover}>
            </Field>

            <Field label="Story" description="Markdown works: ## headings, **bold**, - lists and [links](https://example.com)." error={form.errors.story?.[0] ?? ""}>
              <Tabs value={form.tab}>
                <TabsList label="Story">
                  <TabsTrigger value="write">Write</TabsTrigger>
                  <TabsTrigger value="preview">Preview</TabsTrigger>
                </TabsList>
                <TabsContent value="write">
                  <Textarea name="story" class="story-source" rows={12} value={form.story} />
                </TabsContent>
                <TabsContent value="preview">
                  <div class="story-preview prose">{raw(renderMarkdown(form.story))}</div>
                </TabsContent>
              </Tabs>
            </Field>
          </FieldGroup>

          <div class="form-actions row gap-3">
            <Button variant="ghost" href="/dashboard">Cancel</Button>
            <Button type="submit" variant="primary" loading={form.busy}>Publish campaign</Button>
          </div>
        </form>
      </div>
    </Layout>
  </body>
</html>
