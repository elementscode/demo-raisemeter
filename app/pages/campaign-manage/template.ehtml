import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { LiveView, ValidationError } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { ProgressMeter } from "#app/shared/templates/progress-meter";
import { Donation } from "#app/shared/services/donations";
import { DonationRecord, postUpdate } from "#app/shared/services/organizer";
import { formatMoney } from "#app/shared/money";
import { formatDate, timeAgo } from "#app/shared/time";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent, CardFooter } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Table, TableCell, TableHead } from "@elements/ui/table";
import { Textarea } from "@elements/ui/textarea";

const TABLE_ROWS = 50;

interface ManagedCampaign {
  id: string;
  slug: string;
  title: string;
  goalCents: number;
}

interface UpdateRow {
  id: string;
  title: string;
  createdAt: Date;
}

interface UpdateDraft {
  title: string;
  body: string;
  errors: { title?: string[]; body?: string[] };
  error: string;
  sent: string;
  busy: boolean;
}

function raised(live: LiveView<Donation>): number {
  return live.reduce((sum, d) => sum + d.amountCents, 0);
}

function average(live: LiveView<Donation>): number {
  return live.length ? Math.round(raised(live) / live.length) : 0;
}

function onPost(campaignId: string, draft: UpdateDraft, updates: UpdateRow[]) {
  draft.errors = {};
  draft.error = "";
  draft.sent = "";
  draft.busy = true;

  try {
    let recipients = postUpdate({ campaignId, title: draft.title, body: draft.body });

    updates.unshift({ id: crypto.randomUUID(), title: draft.title.trim(), createdAt: new Date() });
    draft.sent = `Posted. It's on your campaign page and on its way to ${recipients} ${recipients === 1 ? "donor" : "donors"}.`;
    draft.title = "";
    draft.body = "";
  } catch (err: any) {
    if (err instanceof ValidationError && err.errors) {
      draft.errors = err.errors;
    } else {
      draft.error = err.message;
    }
  }

  draft.busy = false;
}

<html lang="en" class="page-campaign-manage" (
  campaign: ManagedCampaign,
  live: LiveView<Donation>,
  records: DonationRecord[],
  updates: UpdateRow[],
  private draft: UpdateDraft = { title: "", body: "", errors: {}, error: "", sent: "", busy: false },
)>
  <head>
    <title>Manage · {campaign.title} · raisemeter</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="page-shell manage stack is-xl">
        <div class="manage-head cluster">
          <div class="stack is-xs">
            <p class="eyebrow"><a class="link-muted" href="/dashboard">Your campaigns</a></p>
            <h1>{campaign.title}</h1>
          </div>
          <div class="cluster is-sm">
            <Button href={`/c/${campaign.slug}`}>View public page</Button>
            <Button variant="primary" href={`/dashboard/c/${campaign.id}/donations.csv`} attrs={{ download: true }}>Download CSV</Button>
          </div>
        </div>

        <div class="manage-grid">
          <Card title="Progress" level={2}>
            <CardContent class="stack is-lg">
              <ProgressMeter raisedCents={raised(live)} goalCents={campaign.goalCents} large={true} />
              <div class="stat-row">
                <div class="stat"><strong>{live.length.toLocaleString("en-US")}</strong><span class="hint">donors</span></div>
                <div class="stat"><strong>{formatMoney(average(live))}</strong><span class="hint">average gift</span></div>
                <div class="stat"><strong>{formatMoney(Math.max(0, campaign.goalCents - raised(live)))}</strong><span class="hint">to go</span></div>
              </div>
            </CardContent>
          </Card>

          <form onsubmit={() => onPost(campaign.id, draft, updates)}>
            <Card title="Post an update" level={2}>
              <CardContent class="stack is-md">
                <p class="hint">It shows on your campaign page and is emailed to everyone who has given.</p>
                <Alert e:if={draft.sent} variant="success" role="status" description={draft.sent} />
                <Alert e:if={draft.error} variant="danger" description={draft.error} />

                <Field label="Title" error={draft.errors.title?.[0] ?? ""}>
                  <Input placeholder="We broke ground!" value={draft.title} attrs={{ maxlength: 120 }} />
                </Field>

                <Field label="Message" error={draft.errors.body?.[0] ?? ""}>
                  <Textarea rows={5} placeholder="Markdown works here too." value={draft.body} />
                </Field>
              </CardContent>
              <CardFooter>
                <Button type="submit" variant="primary" loading={draft.busy}>Post and email donors</Button>
              </CardFooter>
            </Card>
          </form>
        </div>

        <section e:if={updates.length} aria-labelledby="updates-title">
          <Card title="Posted updates" level={2} titleId="updates-title">
            <CardContent>
              <ul class="stack is-sm">
                <li e:for={u of updates} class="row is-baseline gap-3">
                  <span class="hint">{formatDate(u.createdAt)}</span>
                  <span>{u.title}</span>
                </li>
              </ul>
            </CardContent>
          </Card>
        </section>

        <section aria-labelledby="donations-title">
          <Card title="Donations" level={2} titleId="donations-title">
            <Table label="Donations">
              <table>
                <thead>
                  <tr>
                    <TableHead>When</TableHead>
                    <TableHead>Name</TableHead>
                    <TableHead class="email">Email</TableHead>
                    <TableHead class="message" wrap>Message</TableHead>
                    <TableHead align="end">Amount</TableHead>
                  </tr>
                </thead>
                <tbody>
                  <tr e:for={r of records.slice(0, TABLE_ROWS)}>
                    <TableCell class="date">{timeAgo(r.createdAt)}</TableCell>
                    <TableCell>{r.donorName ?? "Anonymous"}</TableCell>
                    <TableCell class="email">{r.email}</TableCell>
                    <TableCell class="message" wrap>{r.message}</TableCell>
                    <TableCell align="end">{formatMoney(r.amountCents)}</TableCell>
                  </tr>
                </tbody>
              </table>
            </Table>
            <CardFooter e:if={records.length > TABLE_ROWS}>
              <span class="hint">Showing the newest {TABLE_ROWS} of {records.length}.</span>
              <Button size="sm" href={`/dashboard/c/${campaign.id}/donations.csv`} attrs={{ download: true }}>Download all as CSV</Button>
            </CardFooter>
          </Card>
        </section>
      </div>
    </Layout>
  </body>
</html>
