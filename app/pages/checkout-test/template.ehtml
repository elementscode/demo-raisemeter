import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { redirect, ValidationError } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { formatMoney } from "#app/shared/money";
import { payTestCheckout, TestCheckout } from "./services";
import { Alert } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

interface PayForm {
  email: string;
  error: string;
  emailError: string;
  busy: boolean;
}

function onPay(checkoutId: string, form: PayForm) {
  form.error = "";
  form.emailError = "";
  form.busy = true;

  try {
    let slug = payTestCheckout(checkoutId, form.email);
    redirect(`/c/${slug}?thanks=1`);
  } catch (err: any) {
    form.busy = false;

    if (err instanceof ValidationError && err.errors?.email) {
      form.emailError = err.errors.email[0];
    } else {
      form.error = err.message;
    }
  }
}

<html lang="en" class="page-checkout-test" (
  checkout: TestCheckout,
  private form: PayForm = { email: "", error: "", emailError: "", busy: false },
)>
  <head>
    <title>Checkout · raisemeter</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="page-shell">
        <div class="pay stack is-lg">
          <div class="pay-head row">
            <h1>Checkout</h1>
            <Badge variant="warning" dot>Test mode</Badge>
          </div>

          <form onsubmit={() => onPay(checkout.id, form)}>
            <Card>
              <CardContent class="stack is-lg">
                <div class="pay-line">
                  <img src={checkout.coverUrl} alt="" width="96" height="72">
                  <div class="stack is-xs">
                    <p class="pay-item">Donation to {checkout.campaignTitle}</p>
                    <p class="hint">Organized by {checkout.organizerName}</p>
                  </div>
                  <span class="pay-amount">{formatMoney(checkout.amountCents)}</span>
                </div>

                <div class="pay-wall stack is-xs">
                  <p class="text-sm">On the wall as <strong>{checkout.donorName ?? "Anonymous"}</strong></p>
                  <p e:if={checkout.message} class="pay-message">“{checkout.message}”</p>
                </div>

                <div class="pay-total row is-baseline">
                  <span>Total</span>
                  <strong>{formatMoney(checkout.amountCents)} <small>USD</small></strong>
                </div>

                <Alert e:if={form.error} variant="danger" description={form.error} />

                <Field label="Email for your receipt" error={form.emailError}>
                  <Input name="email"
                         type="email"
                         placeholder="you@example.com"
                         value={form.email}
                         required
                         attrs={{ autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
                </Field>

                <div class="stack is-sm">
                  <Button type="submit" variant="primary" size="lg" block loading={form.busy}>
                    Pay {formatMoney(checkout.amountCents)}
                  </Button>
                  <a class="pay-cancel link-muted text-sm" href={`/c/${checkout.campaignSlug}`}>Cancel and go back</a>
                </div>
              </CardContent>
            </Card>
          </form>

          <div class="pay-note stack is-xs">
            <p class="callout-title">No card is charged here</p>
            <p>This is the app's test checkout, so donations work before Stripe is connected. Add <code>STRIPE_SECRET_KEY</code> to <code>config/env/development.env</code> and the Donate button goes to real Stripe Checkout.</p>
          </div>
        </div>
      </div>
    </Layout>
  </body>
</html>
