import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { LiveView, raw, redirect, session, ValidationError } from "@elements/app";
import { Layout } from "#app/shared/templates/layout";
import { ProgressMeter } from "#app/shared/templates/progress-meter";
import { CampaignDetail } from "#app/shared/services/campaigns";
import { Donation } from "#app/shared/services/donations";
import { startDonation, MAX_MESSAGE, MAX_NAME } from "#app/shared/services/checkout";
import { formatMoney } from "#app/shared/money";
import { formatDate, timeAgo } from "#app/shared/time";
import { Alert } from "@elements/ui/alert";
import { Avatar } from "@elements/ui/avatar";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardAction, CardContent, CardFooter } from "@elements/ui/card";
import { Checkbox } from "@elements/ui/checkbox";
import { Field, FieldLabel } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { InputGroup, InputGroupAddon, InputGroupText } from "@elements/ui/input-group";
import { Textarea } from "@elements/ui/textarea";
import { ToggleGroup, ToggleGroupItem } from "@elements/ui/toggle-group";

const PRESETS = ["25", "50", "100", "250"];

interface DonateState {
  amount: string;
  name: string;
  anonymous: boolean;
  message: string;
  errors: { amount?: string[]; name?: string[]; message?: string[] };
  error: string;
  busy: boolean;
  open: boolean;
}

function raised(donations: LiveView<Donation>): number {
  return donations.reduce((sum, d) => sum + d.amountCents, 0);
}

function recent(donations: LiveView<Donation>, limit: number): Donation[] {
  return donations.sort((a, b) => +b.createdAt - +a.createdAt).slice(0, limit);
}

function isNew(d: Donation): boolean {
  return Date.now() - +d.createdAt < 15_000;
}

function initials(name: string | null): string {
  if (!name) {
    return "♥";
  }

  return name.split(/\s+/).filter((w) => /^\p{L}/u.test(w)).slice(0, 2).map((w) => w[0].toUpperCase()).join("") || "♥";
}

async function onDonate(campaignId: string, form: DonateState) {
  form.errors = {};
  form.error = "";
  form.busy = true;

  try {
    let url = await startDonation({
      campaignId,
      amount: Number(form.amount),
      name: form.name,
      anonymous: form.anonymous,
      message: form.message,
    });

    redirect(url);
  } catch (err: any) {
    form.busy = false;

    if (err instanceof ValidationError && err.errors) {
      form.errors = err.errors;
    } else {
      form.error = err.message;
    }
  }
}

<html lang="en" class="page-campaign" (
  campaign: CampaignDetail,
  donations: LiveView<Donation>,
  thanks: boolean,
  pending: boolean,
  private wall: { limit: number } = { limit: 8 },
  private form: DonateState = { amount: "50", name: "", anonymous: false, message: "", errors: {}, error: "", busy: false, open: false },
)>
  <head>
    <title>{campaign.title} · raisemeter</title>
    <meta name="description" content={campaign.summary}>
    <meta property="og:image" content={campaign.coverUrl}>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="page-shell campaign stack is-xl">
        <Alert e:if={thanks} variant="success" role="status" title="Thank you for your gift." description="It is on the wall below, and your receipt is on its way to your inbox." />
        <Alert e:if={pending} variant="info" role="status" title="Your payment is processing." description="Your gift will appear on the wall once your bank confirms it." />

        <div class="layout-grid">
          <div class="campaign-top stack is-xl">
            <img class="cover" src={campaign.coverUrl} alt="" width="1600" height="900">

            <header class="campaign-head stack is-sm">
              <h1 class="text-balance">{campaign.title}</h1>
              <p class="lede">{campaign.summary}</p>
              <p class="text-sm">
                Organized by <strong>{campaign.organizerName}</strong> · started {formatDate(campaign.createdAt)}
                <span e:if={session.get("userId") === campaign.organizerId}> · <a class="link-action" href={`/dashboard/c/${campaign.id}`}>Manage this campaign</a></span>
              </p>
            </header>
          </div>

          <div class="campaign-main stack is-xl">
            <article class="prose story">{raw(campaign.storyHtml)}</article>

            <section e:if={campaign.updates.length} class="stack">
              <h2>Updates <Badge variant="secondary">{campaign.updates.length}</Badge></h2>
              <div>
                <article e:for={u of campaign.updates} class="update stack is-sm">
                  <p class="eyebrow">{formatDate(u.createdAt)}</p>
                  <h3>{u.title}</h3>
                  <div class="prose">{raw(u.bodyHtml)}</div>
                </article>
              </div>
            </section>
          </div>

          <aside class="sidebar stack is-lg">
            <Card>
              <CardContent class="stack is-lg">
                <div class="stack is-sm">
                  <ProgressMeter raisedCents={raised(donations)} goalCents={campaign.goalCents} large={true} />
                  <p class="donor-count">
                    <strong>{donations.length.toLocaleString("en-US")}</strong> {donations.length === 1 ? "donor" : "donors"}
                  </p>
                </div>

                <div e:if={!form.open} class="stack is-sm">
                  <Button variant="primary" size="lg" block onclick={() => form.open = true}>Donate</Button>
                  <p class="hint text-center">Any amount, by card through Stripe. You'll get an emailed receipt.</p>
                </div>

                <form e:else class="stack is-md" onsubmit={() => onDonate(campaign.id, form)}>
                  <Alert e:if={form.error} variant="danger" description={form.error} />

                  <Field label="Amount" error={form.errors.amount?.[0] ?? ""}>
                    <div class="stack is-sm">
                      <ToggleGroup type="single"
                                   variant="outline"
                                   size="sm"
                                   class="amounts"
                                   label="Preset amounts"
                                   value={form.amount}
                                   onValueChange={(v, details) => !v && details.cancel()}>
                        <ToggleGroupItem e:for={p of PRESETS} value={p}>${p}</ToggleGroupItem>
                      </ToggleGroup>
                      <InputGroup>
                        <InputGroupAddon><InputGroupText>$</InputGroupText></InputGroupAddon>
                        <Input type="number"
                               name="amount"
                               class="amount-input"
                               value={form.amount}
                               required
                               attrs={{ inputmode: "decimal", min: 1, max: 50000, step: 0.01 }} />
                      </InputGroup>
                    </div>
                  </Field>

                  <Field label="Your name" error={form.errors.name?.[0] ?? ""}>
                    <Input name="name"
                           placeholder="Shown on the donation wall"
                           disabled={form.anonymous}
                           value={form.name}
                           attrs={{ autocomplete: "name", maxlength: MAX_NAME }} />
                  </Field>

                  <Field orientation="horizontal" label="Give anonymously" reserveError={false}>
                    <Checkbox checked={form.anonymous} />
                  </Field>

                  <Field error={form.errors.message?.[0] ?? ""}>
                    <FieldLabel>Message <span class="hint">(optional)</span></FieldLabel>
                    <Textarea name="message"
                              rows={3}
                              maxlength={MAX_MESSAGE}
                              placeholder="Say why you're giving"
                              value={form.message} />
                  </Field>

                  <Button type="submit" variant="primary" size="lg" block loading={form.busy}>
                    Donate {Number(form.amount) >= 1 ? formatMoney(Math.round(Number(form.amount) * 100)) : ""}
                  </Button>
                  <p class="hint text-center">Secure card payment by Stripe. You'll get an emailed receipt.</p>
                </form>
              </CardContent>
            </Card>

            <section aria-label="Recent donations">
              <Card title="Recent donations" level={2}>
                <CardAction slot="action"><Badge variant="success" dot>Live</Badge></CardAction>
                <CardContent>
                  <ol e:if={donations.length} class="wall" aria-live="polite">
                    <li e:for={d of recent(donations, wall.limit)} class={["wall-item", isNew(d) && "is-new"]}>
                      <Avatar fallback={initials(d.donorName)} />
                      <div>
                        <div class="wall-line row is-baseline">
                          <span class="wall-name truncate">{d.donorName ?? "Anonymous"}</span>
                          <span class="wall-amount">{formatMoney(d.amountCents)}</span>
                        </div>
                        <p e:if={d.message} class="wall-message">{d.message}</p>
                        <span class="wall-time">{timeAgo(d.createdAt)}</span>
                      </div>
                    </li>
                  </ol>
                  <p e:else class="hint">No donations yet. Be the first.</p>
                </CardContent>
                <CardFooter e:if={donations.length > wall.limit}>
                  <Button variant="link" size="sm" onclick={() => wall.limit += 25}>Show more</Button>
                </CardFooter>
              </Card>
            </section>
          </aside>
        </div>
      </div>
    </Layout>
  </body>
</html>
